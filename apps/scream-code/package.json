{
  "name": "scream-code",
  "version": "0.15.2",
  "description": "A terminal-native AI agent for builders",
  "license": "MIT",
  "author": "ScreamCli",
  "homepage": "https://github.com/LIUTod/scream-code/tree/main/apps/scream-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LIUTod/scream-code.git",
    "directory": "apps/scream-code"
  },
  "bugs": {
    "url": "https://github.com/LIUTod/scream-code/issues"
  },
  "keywords": [
    "scream",
    "scream-code",
    "cli",
    "agent",
    "coding-agent",
    "ai",
    "tui"
  ],
  "bin": {
    "scream": "dist/main.mjs"
  },
  "files": [
    "dist",
    "icon.ico"
  ],
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && pnpm exec vite build src/web/frontend && node scripts/copy-web-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:cli-only": "tsx --import ../../build/register-raw-text-loader.mjs ./src/main.ts",
    "dev:prod": "node dist/main.mjs",
    "web:build": "pnpm exec vite build src/web/frontend",
    "web:dev": "pnpm exec vite dev src/web/frontend",
    "web:typecheck": "vue-tsc --noEmit -p src/web/frontend/tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w run build:packages && vitest run",
    "e2e": "pnpm -w run build:packages && SCREAM_E2E=1 vitest run test/e2e",
    "e2e:real": "pnpm -w run build:packages && SCREAM_E2E_REAL=1 vitest run test/e2e/real-llm-smoke.e2e.test.ts",
    "prepublishOnly": "node scripts/verify-publish.mjs",
    "smoke": "node dist/main.mjs --version"
  },
  "dependencies": {
    "@liutod-scream/pi-tui": "^0.84.4",
    "@mariozechner/clipboard": "^0.3.2",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "diff": "^9.0.0",
    "fastembed": "^2.1.0",
    "marked": "^15.0.7",
    "mupdf": "^1.28.0",
    "qrcode": "^1.5.4",
    "semver": "^7.7.4",
    "shiki": "^3.2.1",
    "smol-toml": "^1.6.1",
    "ws": "^8.21.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@scream-code/agent-core": "workspace:^",
    "@scream-code/config": "workspace:^",
    "@scream-code/evals": "workspace:^",
    "@scream-code/knowledge": "workspace:*",
    "@scream-code/memory": "workspace:*",
    "@scream-code/scream-code-sdk": "workspace:^",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^24.1.3",
    "tsx": "^4.21.0",
    "vite": "^6.3.5",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
