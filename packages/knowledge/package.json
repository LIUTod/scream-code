{
  "name": "@scream-code/knowledge",
  "version": "0.19.0",
  "private": true,
  "description": "Local knowledge base library for scream-code agent retrieval",
  "license": "MIT",
  "author": "ScreamCli AI",
  "homepage": "https://github.com/LIUTod/scream-code/tree/main/packages/knowledge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LIUTod/scream-code.git",
    "directory": "packages/knowledge"
  },
  "bugs": {
    "url": "https://github.com/LIUTod/scream-code/issues"
  },
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markit": {
      "types": "./src/markit/index.ts",
      "default": "./src/markit/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scream-code/memory": "workspace:*",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.0",
    "mupdf": "^1.28.0",
    "pathe": "^2.0.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6"
  }
}
